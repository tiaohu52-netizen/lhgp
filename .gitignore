promo/*.gif
promo/*.webm
promo/demo-data/

# 一次性 scratch / 调试日志（被移动到 .scratch-trash/ 后由本规则忽略）
.scratch-trash/
# 老路径 scratch-trash/（已弃用，但仍可能留有调试文件）
scratch-trash/
# 批量移动脚本留下的临时清单（运行完即空，不是仓库内容）
_move_list.json

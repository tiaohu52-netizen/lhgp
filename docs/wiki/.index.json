      "headings": [
        {
          "level": 1,
          "text": "四层代码审查"
        },
        {
          "level": 2,
          "text": "第 1 层 · 类型层"
        },
        {
          "level": 2,
          "text": "第 2 层 · 死代码层"
        },
        {
          "level": 2,
          "text": "第 3 层 · 边界层"
        },
        {
          "level": 3,
          "text": "三条硬规则"
        },
        {
          "level": 3,
          "text": "边界层的判定不是「有没有 bug」，而是「错了往哪边倒」"
        },
        {
          "level": 2,
          "text": "第 4 层 · 跑一遍层"
        },
        {
          "level": 3,
          "text": "反向验证（这一层真正的核心）"
        },
        {
          "level": 1,
          "text": "变异验证的最小形态：改坏 → 只跑那条测试 → 断言「变红」且失败名匹配 → 还原"
        },
        {
          "level": 1,
          "text": "判据: returncode != 0  且  FAILED 行里出现预期测试名  且 不是收集错误"
        },
        {
          "level": 2,
          "text": "本轮实测（2026-09-10，作为四层的样例记录）"
        },
        {
          "level": 2,
          "text": "反模式"
        },
        {
          "level": 2,
          "text": "验证清单"
        }
      ]

      "block_ids": [],
      "headings": [
        {
          "level": 1,
          "text": "Regression patterns from external review"
        },
        {
          "level": 2,
          "text": "1. The mock-envelope bypass"
        },
        {
          "level": 2,
          "text": "2. Handler transitions only the status, not the full state"
        },
        {
          "level": 2,
          "text": "3. Two-namespace parser divergence"
        },
        {
          "level": 2,
          "text": "4. CLI branch conditionally imports"
        },
        {
          "level": 2,
          "text": "5. Spec-vs-execution shape mismatch"
        },
        {
          "level": 2,
          "text": "6. docstring blow-up"
        },
        {
          "level": 2,
          "text": "7. Concurrent multi-event handler without pre-read CAS"
        },
        {
          "level": 1,
          "text": "Single-threaded: events + state update both commit,"
        },
        {
          "level": 1,
          "text": "revision is consistent.  Test passes."
        },
        {
          "level": 2,
          "text": "8. The lazy \"no real entry, just mock\" test"
        },
        {
          "level": 2,
          "text": "New-PR checklist"
        },
        {
          "level": 2,
          "text": "9. Trusted pre-authorization at the Goal layer (model self-sign fix)"
        },
        {
          "level": 2,
          "text": "10. Goal-level execution config (workspace + executor_grant)"
        },
        {
          "level": 2,
          "text": "11. The optional field with a fail-open comparison"
        }
      ]
    },
